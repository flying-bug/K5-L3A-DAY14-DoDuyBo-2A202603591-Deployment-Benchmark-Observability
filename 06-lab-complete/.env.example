# ============================================================
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# KHÔNG commit file .env thật — chỉ commit file .env.example này.
# ============================================================

# Cổng app lắng nghe — platform (Railway/Render) tự inject giá trị thật
PORT=8000

# development | staging | production
ENVIRONMENT=development

# Bắt buộc — key client phải gửi qua header X-API-Key
AGENT_API_KEY=dev-key

# Kết nối Redis (rate limit + cost guard) — service "redis" trong docker-compose.yml
REDIS_URL=redis://localhost:6379/0

# Số request / phút tối đa cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Ngân sách USD/ngày — vượt → HTTP 402. Có thể dùng MONTHLY_BUDGET_USD thay thế.
DAILY_BUDGET_USD=10
MONTHLY_BUDGET_USD=100
